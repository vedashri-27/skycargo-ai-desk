OPENAI_API_KEY=sk-your-key-here
# Any model your key can use with the Agents SDK. Default comes from the ChatKit docs example.
OPENAI_MODEL=gpt-6-astra
# Optional: use an OpenAI-compatible provider instead, e.g. Gemini's free tier:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# (then set OPENAI_API_KEY to your Gemini key and OPENAI_MODEL to a Gemini model name)
LOG_LEVEL=INFO
